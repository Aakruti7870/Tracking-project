# TrackMyRMC backend environment template — never put real secrets in this file.
APP_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=trackmyrmc

# Required in production (use long random values; no defaults are accepted).
JWT_SECRET=replace-with-secure-random-secret
OTP_PEPPER=replace-with-separate-secure-random-secret
DEBUG_OTP=false
SESSION_TTL_SECONDS=604800
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30

# Plant Owner / RMC staff Google OAuth. Create a Google OAuth Web client and
# register the HTTPS backend callback exactly as GOOGLE_OAUTH_REDIRECT_URI.
# Never place GOOGLE_OAUTH_CLIENT_SECRET in the mobile app or repository.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://trackmyrmc.com/api/auth/google/callback
GOOGLE_OAUTH_APP_REDIRECT_URI=trackmyrmc://auth/google

# Comma-separated trusted browser origins. Production must not contain '*'.
CORS_ORIGINS=https://trackmyrmc.com

# SMS OTP / delivery alerts (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email provider remains available for operational notifications and verified
# account-deletion ownership flows. Staff sign-in itself uses Google OAuth.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Firebase Cloud Messaging HTTP v1. Keep the Admin credential only in the
# deployment secret store. Base64 is preferred for multiline JSON credentials.
FIREBASE_PROJECT_ID=track-my-rmc
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_B64=

# Server-side Google Places / Geocoding / Routes key.
GOOGLE_MAPS_KEY=

# Customer tracking/POD link base.
APP_PUBLIC_URL=https://trackmyrmc.com

# Object storage: production should use remote. CI may set STORAGE_MODE=local.
STORAGE_MODE=remote
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
EMERGENT_LLM_KEY=
LOCAL_STORAGE_DIR=/tmp/trackmyrmc-storage
