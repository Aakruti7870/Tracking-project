# TrackMyRMC Expo build configuration.
# EXPO_PUBLIC_* values are embedded in the JavaScript bundle; never put secrets there.
EXPO_PUBLIC_BACKEND_URL=https://api.trackmyrmc.com

# Build-time Google Maps SDK for Android key.
# Restrict this key in Google Cloud to the TrackMyRMC Android package + signing SHA-1
# and to Maps SDK for Android only. Do not commit a real value here.
GOOGLE_MAPS_ANDROID_KEY=
