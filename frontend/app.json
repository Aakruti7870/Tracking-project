{
  "expo": {
    "name": "TrackMyRMC",
    "slug": "frontend",
    "version": "2.0.21",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trackmyrmc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trackmyrmc.concreteking",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture site photos for proof of delivery",
        "NSPhotoLibraryUsageDescription": "Attach site photos to proof of delivery",
        "NSLocationWhenInUseUsageDescription": "Allow TrackMyRMC to record your location for attendance, approved client visits and active delivery trips",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow TrackMyRMC to share the mixer location while an active delivery trip is running"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.trackmyrmc.concreteking",
      "versionCode": 79,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "trackmyrmc.com",
              "pathPrefix": "/kyc/return"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TrackMyRMC to record your location for attendance, approved client visits and active delivery trips.",
          "locationAlwaysAndWhenInUsePermission": "Allow TrackMyRMC to share the mixer location while an active delivery trip is running.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "./plugins/with-play-store-compatibility"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}